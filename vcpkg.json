{
  "name": "geoworld",
  "version-string": "0.1.0",
  "dependencies": [
    "flecs",
    "flatbuffers"
  ],
  "features": {
    "m2": {
      "description": "Spatial and GIS dependencies",
      "dependencies": ["gdal", "h3", "m2-spatial"]
    },
    "m2-spatial": {
      "description": "Coordinate and global spatial key dependencies",
      "dependencies": ["proj", "s2geometry"]
    },
    "m3": {
      "description": "Rules and AI dependencies",
      "dependencies": [
        "behaviortree-cpp",
        "nlohmann-json",
        "json-schema-validator",
        "lua",
        "sol2",
        { "name": "wasmedge", "default-features": false }
      ]
    },
    "m3-tooling-gui": {
      "description": "M3 behavior authoring desktop UI and graph layout",
      "dependencies": [
        { "name": "qtbase", "default-features": false, "features": ["fontconfig", "freetype", "gui", "opengl", "widgets", "xcb"] },
        { "name": "graphviz", "features": ["tools"] }
      ]
    },
    "m4": {
      "description": "Protocol and gateway dependencies",
      "dependencies": ["grpc", "protobuf", "boost-asio", "boost-beast", "openssl", "mimalloc"]
    },
    "m5": {
      "description": "Persistence, WAL and replay dependencies",
      "dependencies": ["crc32c", "zstd", "mio", "boost-uuid", "immer"]
    },
    "observability": {
      "description": "Production logging and tracing adapters",
      "dependencies": ["fmt", "spdlog"]
    },
    "benchmarks": {
      "description": "ECS comparison benchmarks",
      "dependencies": ["entt"]
    },
    "tests": {
      "description": "External test framework",
      "dependencies": ["catch2"]
    }
  }
}

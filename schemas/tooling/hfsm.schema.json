{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "geoworld://schemas/tooling/hfsm/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "machine_id", "initial_state", "states", "transitions"],
  "properties": {
    "schema_version": { "const": 1 },
    "machine_id": { "type": "string", "minLength": 1 },
    "initial_state": { "type": "string", "minLength": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "parent", "position"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "parent": { "type": "string" },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "event", "target", "priority"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "event": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" }
        }
      }
    }
  }
}
